# Copier en .env.local et compléter. Ne jamais committer .env.local.

# Adresse publique du site (métadonnées, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://verste.fr

# Autoriser l'indexation par les moteurs de recherche (false tant que le site n'est pas lancé)
NEXT_PUBLIC_INDEXABLE=false

# Phase F · envoi de La Première Verste
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
LEAD_FROM_EMAIL="Verste <bonjour@verste.fr>"

# Phase G · checkout préparatoire (mode test, désactivé par défaut)
CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Phase I · fournisseur d'analytics (none | vercel | posthog)
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
